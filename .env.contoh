# Salin berkas ini jadi .env.local, lalu isi nilainya.
# .env.local TIDAK pernah masuk git, dan Tiburon menolak membacanya
# sendiri walau diminta — lihat BERKAS_TERLARANG di lib/izin.ts.

# Kunci OpenRouter. Hanya dipakai di server, tidak pernah dikirim ke peramban.
OPENROUTER_API_KEY=

# Sandi untuk akses dari jaringan.
#
# Localhost TIDAK PERNAH diminta sandi — menuntutnya dari orang yang sudah
# memegang papan ketiknya tidak menambah keamanan apa pun.
#
# Tapi kalau Tiburon dibuka dari alamat jaringan (misalnya 192.168.1.4:3000)
# dan baris ini kosong, permintaannya DITOLAK, bukan diloloskan. Pemasangan
# yang lupa mengisinya harus gagal berisik: kegagalan senyap di sini berarti
# arsip satu kantor terbuka untuk satu jaringan penuh.
SANDI_TIBURON=
